# === ML source — allow Python + JSON model artifacts needed at runtime ===
# Blanket exclusion of ml/ has been removed — backend imports ml.inference.*
# Exclude only what would bloat the image:
ml/**/__pycache__/
ml/**/*.py[cod]
ml/models/weights/*.pt
ml/models/weights/*.pth
ml/models/weights/*.joblib
ml/tests/


