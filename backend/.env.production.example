# --- Application ---
PROJECT_NAME="Antarctic Navigation API"
VERSION="0.1.0"
ENVIRONMENT="production"
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# --- Security ---
# REQUIRED in production. Must be >= 32 characters.
SECRET_KEY="CHANGE_ME_WITH_python_-c_'import_secrets;_print(secrets.token_urlsafe(48))'"

# --- CORS ---
# Explicit allowlist of trusted frontend origins. NEVER use "*".
BACKEND_CORS_ORIGINS="https://dashboard.example.com,https://ops.example.com"

# --- Pagination ---
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

# --- Database ---
# These are overridden by the docker-compose.yml service definition for the api/worker containers.
POSTGRES_SERVER="db"
POSTGRES_USER="antarctic"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_RANDOM_PASSWORD"
POSTGRES_DB="antarctic_nav"
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- Redis / Celery ---
REDIS_URI="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# --- External integrations ---
EXTERNAL_DATA_TIMEOUT=30.0
RISK_CONFIDENCE_THRESHOLD=0.5

# --- Reverse proxy ---
# Set to true when behind nginx/ALB. The X-Forwarded-* headers will be honored.
TRUST_PROXY_HEADERS=true
# Comma-separated list of allowed hostnames. REQUIRED when TRUST_PROXY_HEADERS=true.
TRUSTED_HOSTS="api.example.com,ops.example.com"
