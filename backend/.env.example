# --- Application ---
PROJECT_NAME="Antarctic Navigation API"
VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# --- Security ---
# 32+ random characters required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""

# --- CORS ---
# Comma-separated list of allowed origins. NEVER use "*" in production.
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:3000,http://localhost:8080"

# --- Pagination ---
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

# --- Database ---
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="antarctic_nav"
POSTGRES_PORT=5433
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- Redis / Celery ---
REDIS_URI="redis://localhost:6379/0"
CELERY_BROKER_URL=""
CELERY_RESULT_BACKEND=""

# --- External integrations ---
EXTERNAL_DATA_TIMEOUT=30.0
RISK_CONFIDENCE_THRESHOLD=0.5

# --- Reverse proxy ---
TRUST_PROXY_HEADERS=false
# Comma-separated list of allowed hostnames (e.g. "api.example.com,localhost").
# Wildcard ("*") is rejected in production.
TRUSTED_HOSTS=localhost,127.0.0.1
